{
  "name": "crdt-collaborative-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "dev": "vite",
    "server": "cross-env HOST=0.0.0.0 PORT=1234 YPERSISTENCE=./.data node ./server.cjs",
    "server:replica:a": "cross-env HOST=0.0.0.0 PORT=1235 COORDINATOR_URL=http://127.0.0.1:1234 node ./replica.cjs",
    "server:replica:b": "cross-env HOST=0.0.0.0 PORT=1236 COORDINATOR_URL=http://127.0.0.1:1234 node ./replica.cjs",
    "dev:replica:a": "cross-env VITE_BACKEND_URL=http://127.0.0.1:1235 vite --port 5173 --strictPort",
    "dev:replica:b": "cross-env VITE_BACKEND_URL=http://127.0.0.1:1236 vite --port 5174 --strictPort",
    "dev:scale": "concurrently -k \"npm:server\" \"npm:server:replica:a\" \"npm:server:replica:b\" \"npm:dev:replica:a\" \"npm:dev:replica:b\"",
    "dev:all": "concurrently -k \"npm:server\" \"npm:dev\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tiptap/extension-collaboration": "^3.31.3",
    "@tiptap/extension-collaboration-caret": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "cross-env": "^7.0.3",
    "diff": "^9.0.0",
    "lib0": "^0.2.119",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.6",
    "y-websocket": "^1.5.4",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
  }
}
